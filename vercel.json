{
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "vite"
        },
        {
            "src": "backend/api/index.ts",
            "use": "@vercel/node",
            "config": {
                "maxDuration": 60
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}